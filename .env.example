# ════════════════════════════════════════════════
# ITARC SERVER — Environment Variables
# Copy to .env and fill in every value
# NEVER commit .env to GitHub
# ════════════════════════════════════════════════

# Google Drive
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"itarc-website",...}
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_shared_drive_folder_id_here
GOOGLE_DRIVE_APPROVED_FOLDER_ID=your_approved_folder_id_here

# SendGrid (email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@itarcbusiness.com

# Counsellor contact
COUNSELLOR_EMAIL=counsellor@itarcbusiness.com
COUNSELLOR_PHONE=+918454992179

# Twilio (WhatsApp reminders)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# Security
ADMIN_PASSWORD=choose_a_strong_password_here

# Server
UPLOAD_PORTAL_URL=https://itarcbusiness.com
PORT=3000
